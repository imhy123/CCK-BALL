#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    td0: td0 {
        compatible = "zmk,behavior-tap-dance";
        #binding-cells = <0>;
        bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <19 20>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <16 15>;
        };

        double_quote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <33 34>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <21 22>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <25 26>;
        };

        single_quota {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <46 45>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp GRAVE         &kp N1        &kp N2                &kp N3            &kp N4  &kp N5     &kp N6     &kp N7  &kp N8       &kp N9            &kp N0             &kp BACKSPACE
&kp TAB           &kp Q         &kp W                 &kp E             &kp R   &kp T      &kp Y      &kp U   &kp I        &kp O             &kp P              &kp BSLH
&mt LCTRL ESCAPE  &kp A         &kp S                 &kp D             &kp F   &kp G      &kp H      &kp J   &kp K        &kp L             &kp SEMI           &kp RETURN
&td0              &kp Z         &kp X                 &kp C             &kp V   &kp B      &kp N      &kp M   &kp COMMA    &kp DOT           &kp SLASH          &kp RIGHT_SHIFT
&kp LCTRL         &kp LEFT_ALT  &kp LS(LEFT_COMMAND)  &kp LEFT_COMMAND  &mo 3   &mkp RCLK  &mkp LCLK  &mo 2   &lt 1 SPACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp RIGHT_ALT
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        symbol_layers {
            bindings = <
&trans  &trans           &trans       &trans            &trans      &trans       &trans     &trans         &trans          &trans                &trans                 &trans
&trans  &kp N1           &kp N2       &kp N3            &kp N4      &kp N5       &kp N6     &kp N7         &kp N8          &kp N9                &kp N0                 &trans
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH          &kp DOLLAR  &kp PERCENT  &kp CARET  &kp AMPERSAND  &kp ASTERISK    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp PLUS         &kp EQUAL    &kp SINGLE_QUOTE  &trans      &trans       &trans     &kp MINUS      &kp UNDERSCORE  &trans                &trans                 &trans
&trans  &trans           &trans       &trans            &trans      &trans       &trans     &trans         &trans          &trans                &trans                 &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        fn_layers {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR_ALL  &trans          &trans          &trans        &trans           &trans   &trans
&trans  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5          &kp F6          &kp F7          &kp F8        &kp F9           &kp F10  &trans
&trans  &trans        &trans        &trans        &trans        &trans          &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp F11  &trans
&trans  &trans        &trans        &trans        &trans        &trans          &kp DELETE      &kp HOME        &kp END       &trans           &kp F12  &trans
&trans  &trans        &trans        &trans        &trans        &trans          &trans          &trans          &trans        &trans           &trans   &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        scroll-layers {
            bindings = <
&trans  &tb_cpi 400  &tb_cpi 600  &tb_cpi 800  &tb_cpi 1000 &tb_cpi 1200      &tb_cpi 1400      &tb_cpi 1600       &trans  &trans  &trans  &trans
&trans  &trans       &trans       &trans       &trans       &tb_scl_cpi 1200  &tb_scl_cpi 1400  &tb_scl_cpi 1600   &trans  &trans  &trans  &trans
&trans  &trans       &trans       &trans       &trans       &trans            &trans            &trans             &trans  &trans  &trans  &trans
&trans  &trans       &trans       &trans       &trans       &trans            &trans            &trans             &trans  &trans  &trans  &trans
&trans  &trans       &trans       &trans       &trans       &trans            &trans            &trans             &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,,,,,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };
    };
};
